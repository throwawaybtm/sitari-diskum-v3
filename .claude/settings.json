{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status *)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(git show *)",
      "Bash(git grep *)",
      "Bash(git ls-files *)",
      "Bash(node local-test/run-synthetic-tests.js *)",
      "Bash(node local-test/run-synthetic-tests.js)",
      "Bash(node --test local-test/test/*)",
      "Bash(node local-test/setup-local.js --check)",
      "Bash(node local-test/*)",
      "Bash(node --test *)",
      "Bash(node maintenance/build-tailwind.js)",
      "Bash(node .claude/skills/sitari-knowledge/scripts/code-index.mjs *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git branch *)",
      "Bash(git fetch *)",
      "Bash(git checkout *)",
      "Bash(git switch *)",
      "Bash(git stash *)",
      "Bash(git push *)",
      "Bash(npm ci *)",
      "Bash(npm install *)",
      "Bash(npx *)",
      "Bash(clasp *)",
      "WebFetch"
    ],
    "ask": [
      "Bash(rm *)",
      "Bash(git rm *)",
      "Bash(git clean *)",
      "Bash(git branch -d *)",
      "Bash(git branch -D *)",
      "Bash(git branch --delete *)",
      "Bash(git tag -d *)",
      "Bash(git tag --delete *)",
      "Bash(git stash drop *)",
      "Bash(git stash clear*)",
      "Bash(npm uninstall *)",
      "Bash(npm rm *)",
      "Bash(clasp delete*)",
      "Bash(clasp undeploy*)"
    ],
    "deny": [
      "Read(/local-test/vendor/**)",
      "Read(/Admin/DeploymentConfig.js)",
      "Read(/Admin/EmployeeDirectory.js)",
      "Read(/Admin/PublicIntake.js)",
      "Read(/Admin/VisitPicContacts.js)",
      "Read(/Tamu-FO/Destinations.js)",
      "Read(/Tamu-Luar/Destinations.js)",
      "Read(~/.clasprc.json)",
      "Read(**/.clasprc.json)",
      "Edit(/Public/**)",
      "Edit(/deployments/**)",
      "Edit(/AGENTS.md)",
      "Bash(clasp pull *)",
      "Bash(clasp run *)",
      "Bash(git push --force *)",
      "Bash(git push * --delete *)",
      "Bash(git push --delete *)",
      "Bash(git push * -d *)",
      "Bash(git push origin :*)",
      "mcp__clasp__push_files",
      "mcp__clasp__pull_files",
      "mcp__clasp__create_project",
      "mcp__clasp__clone_project"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/sitari-guard.js\"",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "extraKnownMarketplaces": {
    "superpowers-dev": {
      "source": {
        "source": "github",
        "repo": "obra/superpowers",
        "ref": "22f0b463e7a5e579904dd6211a520321035526f7"
      }
    },
    "trailofbits": {
      "source": {
        "source": "github",
        "repo": "trailofbits/skills",
        "ref": "149d7b21f4067765b82e67029730b42d228ef4b4"
      }
    }
  },
  "enabledPlugins": {
    "superpowers@superpowers-dev": true,
    "differential-review@trailofbits": true,
    "insecure-defaults@trailofbits": true
  }
}
