/** Generated by maintenance/build-public.js from the existing intake sources. */
var SI_TARI_INTAKE_=(function(){
/** Server-only TLD directory. Only bidang and pic are rendered in the public form. */
const TLD_DESTINATIONS = [
  { id: 'sekretariat-umpeg', bidang: 'Sekretariat (Umum dan Kepegawaian)', pic: 'Novirianti, A.Md.', phone: 'PHONE_NUMBER_PLACEHOLDER' },
  { id: 'sekretariat-perencanaan', bidang: 'Sekretariat (Program dan Perencanaan)', pic: 'Ilhami Kurnia Putri, S.Kom.', phone: 'PHONE_NUMBER_PLACEHOLDER' },
  { id: 'sekretariat-keuangan', bidang: 'Sekretariat (Keuangan dan Aset)', pic: 'Zuziani, S.E.', phone: 'PHONE_NUMBER_PLACEHOLDER' },
  { id: 'pemberdayaan-koperasi', bidang: 'Bidang Pemberdayaan dan Perlindungan Koperasi', pic: 'Debbi Shinta, S.E.', phone: 'PHONE_NUMBER_PLACEHOLDER' },
  { id: 'pengawasan-koperasi', bidang: 'Bidang Pengawasan Koperasi', pic: 'Mery Sefina Simor, S.Kom.', phone: 'PHONE_NUMBER_PLACEHOLDER' },
  { id: 'pengembangan-mikro', bidang: 'Bidang Pengembangan Usaha Mikro', pic: 'Dewi Astuti, S.E.', phone: 'PHONE_NUMBER_PLACEHOLDER' },
  { id: 'kewirausahaan', bidang: 'Bidang Kewirausahaan', pic: 'Fitria Lestari Pujiastuti, S.E.', phone: 'PHONE_NUMBER_PLACEHOLDER' },
  { id: 'plut-kumkm', bidang: 'UPTD PLUT KUMKM', pic: 'Hafidz Qodli Abdillah, S.E.', phone: 'PHONE_NUMBER_PLACEHOLDER' },
  { id: 'dana-bergulir', bidang: 'UPTD Pengelolaan Dana Bergulir', pic: 'Intan Permata Sari, S.E.', phone: 'PHONE_NUMBER_PLACEHOLDER' }
];

const TLD_MAX_UPLOAD_BYTES = 5 * 1024 * 1024;

function getTldPublicDestinations_() {
  return TLD_DESTINATIONS.map(item => ({ bidang: item.bidang, pic: item.pic }));
}

function validateTldUpload_(value) {
  if (!value) return;
  const match = /^data:(application\/pdf|image\/(?:jpeg|png|webp|heic|heif));base64,([A-Za-z0-9+/]+={0,2})$/.exec(String(value));
  if (!match || match[2].length % 4 !== 0) {
    throw new Error('Dokumen harus berupa PDF atau foto (JPG, PNG, WebP, HEIC).');
  }
  const padding = match[2].endsWith('==') ? 2 : match[2].endsWith('=') ? 1 : 0;
  if ((match[2].length / 4) * 3 - padding > TLD_MAX_UPLOAD_BYTES) {
    throw new Error('Ukuran setiap dokumen maksimal 5 MB.');
  }
}

function validateTldRequiredFields_(payload) {
  const fields = {
    instansi: 'Nama instansi', alamat: 'Alamat instansi', ketua_nama: 'Nama ketua rombongan',
    pengikut_list: 'Daftar anggota rombongan', keperluan: 'Agenda',
    narahubung_hp: 'WhatsApp narahubung', tanggal_kunjungan: 'Tanggal kunjungan',
    jam_kunjungan: 'Jam kunjungan', surat_kunjungan_base64: 'Surat permohonan kunjungan',
    surat_tugas_base64: 'Surat tugas rombongan'
  };
  Object.keys(fields).forEach(field => {
    if (!payload || !String(payload[field] || '').trim()) throw new Error(fields[field] + ' wajib diisi.');
  });
  const count = Number(payload.jumlah_orang);
  if (!Number.isInteger(count) || count < 1) throw new Error('Jumlah orang wajib diisi dengan bilangan bulat minimal 1.');
  if (!/^([01]\d|2[0-3]):[0-5]\d$/.test(payload.jam_kunjungan)) throw new Error('Jam kunjungan tidak valid.');
}

function prepareTldVisit_(payload) {
  validateTldUpload_(payload.surat_kunjungan_base64);
  validateTldUpload_(payload.surat_tugas_base64);
  // Assignment is performed by the admin after reviewing the request.
  return {bidang:'',pic:'',picIds:''};
}

/** Server-only directory. Keep this mapping in sync with TLD; parity is tested locally. */
const TDD_DESTINATIONS = [
  { id: 'sekretariat-umpeg', bidang: 'Sekretariat (Umum dan Kepegawaian)', pic: 'Novirianti, A.Md.', phone: 'PHONE_NUMBER_PLACEHOLDER' },
  { id: 'sekretariat-perencanaan', bidang: 'Sekretariat (Program dan Perencanaan)', pic: 'Ilhami Kurnia Putri, S.Kom.', phone: 'PHONE_NUMBER_PLACEHOLDER' },
  { id: 'sekretariat-keuangan', bidang: 'Sekretariat (Keuangan dan Aset)', pic: 'Zuziani, S.E.', phone: 'PHONE_NUMBER_PLACEHOLDER' },
  { id: 'pemberdayaan-koperasi', bidang: 'Bidang Pemberdayaan dan Perlindungan Koperasi', pic: 'Debbi Shinta, S.E.', phone: 'PHONE_NUMBER_PLACEHOLDER' },
  { id: 'pengawasan-koperasi', bidang: 'Bidang Pengawasan Koperasi', pic: 'Mery Sefina Simor, S.Kom.', phone: 'PHONE_NUMBER_PLACEHOLDER' },
  { id: 'pengembangan-mikro', bidang: 'Bidang Pengembangan Usaha Mikro', pic: 'Dewi Astuti, S.E.', phone: 'PHONE_NUMBER_PLACEHOLDER' },
  { id: 'kewirausahaan', bidang: 'Bidang Kewirausahaan', pic: 'Fitria Lestari Pujiastuti, S.E.', phone: 'PHONE_NUMBER_PLACEHOLDER' },
  { id: 'plut-kumkm', bidang: 'UPTD PLUT KUMKM', pic: 'Hafidz Qodli Abdillah, S.E.', phone: 'PHONE_NUMBER_PLACEHOLDER' },
  { id: 'dana-bergulir', bidang: 'UPTD Pengelolaan Dana Bergulir', pic: 'Intan Permata Sari, S.E.', phone: 'PHONE_NUMBER_PLACEHOLDER' }
];

function getTddPublicDestinations_() {
  return TDD_DESTINATIONS.map(item => ({ bidang: item.bidang, pic: item.pic }));
}

function prepareTddVisit_(payload) {
  const fields = {
    ketua_nama: 'Nama ketua rombongan',
    pengikut_list: 'Daftar anggota rombongan',
    narahubung_hp: 'WhatsApp narahubung',
    keperluan: 'Agenda'
  };
  Object.keys(fields).forEach(field => {
    if (!payload || !String(payload[field] || '').trim()) throw new Error(fields[field] + ' wajib diisi.');
  });
  if (!Number.isInteger(Number(payload.jumlah_orang)) || Number(payload.jumlah_orang) < 1) {
    throw new Error('Total orang harus berupa bilangan bulat minimal 1.');
  }
  const requested = Array.isArray(payload.tujuan_bidang) ? payload.tujuan_bidang : [payload.tujuan_bidang];
  const names = [...new Set(requested)];
  if (!names.length || names.some(name => !TDD_DESTINATIONS.some(item => item.bidang === name))) {
    throw new Error('Pilih minimal satu Bidang Tujuan yang tersedia.');
  }
  const selected = TDD_DESTINATIONS.filter(item => names.indexOf(item.bidang) !== -1);
  return {
    bidang: selected.map(item => item.bidang).join('; '),
    pic: selected.map(item => item.pic).join('; '),
    picIds: selected.map(item => item.id).join('; ')
  };
}

/**
 * SI-TAMU TAMU LUAR
 * Public, write-only intake app connected to the shared SI-TAMU spreadsheet and Drive folders.
 */

const SHARED_DATABASE_NAME = 'DB_SI_TAMU_DISKUM_BATAM';
const FOLDER_ROOT_NAME = 'SI-TAMU DISKUM KOTA BATAM';
const FOLDER_SURAT_NAME = '1. Surat Tamu (Kunjungan & Tugas)';



function getSharedSpreadsheet_() { return getSpreadsheet(); }

function getSuratFolder_() {
  const props = PropertiesService.getScriptProperties();
  const configuredId = props.getProperty('FOLDER_SURAT_ID');
  if (configuredId) {
    try {
      return DriveApp.getFolderById(configuredId);
    } catch (error) {
      throw new Error('FOLDER_SURAT_ID tidak valid atau tidak dapat diakses oleh project Tamu Luar.');
    }
  }

  const rootIterator = DriveApp.getFoldersByName(FOLDER_ROOT_NAME);
  const rootFolder = rootIterator.hasNext() ? rootIterator.next() : DriveApp.createFolder(FOLDER_ROOT_NAME);
  const suratIterator = rootFolder.getFoldersByName(FOLDER_SURAT_NAME);
  const suratFolder = suratIterator.hasNext() ? suratIterator.next() : rootFolder.createFolder(FOLDER_SURAT_NAME);
  props.setProperty('FOLDER_SURAT_ID', suratFolder.getId());
  return suratFolder;
}

function saveBase64ToDrive_(base64Data, fileName, fallbackMimeType) {
  if (!base64Data) return '';
  validateTldUpload_(base64Data);
  const match = String(base64Data).match(/^data:([^;]+);base64,(.+)$/);
  const mimeType = match ? match[1] : fallbackMimeType;
  const cleanBase64 = match ? match[2] : base64Data;
  const blob = Utilities.newBlob(Utilities.base64Decode(cleanBase64), mimeType || 'application/octet-stream', fileName);
  const file = getSuratFolder_().createFile(blob);
  file.setSharing(DriveApp.Access.ANYONE_WITH_LINK, DriveApp.Permission.VIEW);
  return file.getUrl();
}

function assignLiaisonOfficer_(ss, tujuanBidang) {
  const sheet = ss.getSheetByName('Master_Pegawai');
  if (!sheet || sheet.getLastRow() <= 1) return { id: null, nama: 'Petugas FO' };

  const data = sheet.getRange(2, 1, sheet.getLastRow() - 1, sheet.getLastColumn()).getValues();
  let targetBidang = 'Koperasi';
  if (tujuanBidang && tujuanBidang.toLowerCase().indexOf('mikro') > -1) targetBidang = 'Usaha Mikro';

  let candidates = data.filter(row => row[4] === targetBidang && row[5] == 1 && row[7] === 'Aktif');
  if (candidates.length === 0) candidates = data.filter(row => row[5] == 1 && row[7] === 'Aktif');
  if (candidates.length === 0) return { id: null, nama: 'Petugas Piket FO', jabatan: 'Staf Penerima' };

  candidates.sort((a, b) => Number(a[6]) - Number(b[6]));
  const chosen = candidates[0];
  for (let i = 0; i < data.length; i++) {
    if (data[i][0] == chosen[0]) {
      sheet.getRange(i + 2, 7).setValue(Number(chosen[6]) + 1);
      break;
    }
  }

  return { id: chosen[0], nama: chosen[2], jabatan: chosen[3], bidang: chosen[4], nip: chosen[1] };
}

function sortTamu_(ss) {
  const sheet = ss.getSheetByName('Data_Tamu');
  if (!sheet || sheet.getLastRow() <= 2) return;
  sheet.getRange(2, 1, sheet.getLastRow() - 1, sheet.getLastColumn()).sort([
    { column: 13, ascending: false },
    { column: 14, ascending: false }
  ]);
}

function sortSppd_(ss) {
  const sheet = ss.getSheetByName('Kendali_SPPD');
  if (!sheet || sheet.getLastRow() <= 2) return;
  sheet.getRange(2, 1, sheet.getLastRow() - 1, sheet.getLastColumn()).sort([
    { column: 9, ascending: true },
    { column: 1, ascending: false }
  ]);
}

function buildVisitCode_(prefix, dateValue, existingCodes) {
  if (prefix !== 'TLD' && prefix !== 'TDD') {
    throw new Error('Visit code prefix must be TLD or TDD.');
  }

  const dateMatch = /^(\d{4})-(\d{2})-(\d{2})$/.exec(String(dateValue || ''));
  if (!dateMatch) throw new Error('Visit date must use yyyy-MM-dd format.');

  const year = Number(dateMatch[1]);
  const month = Number(dateMatch[2]);
  const day = Number(dateMatch[3]);
  const parsed = new Date(Date.UTC(year, month - 1, day));
  if (
    parsed.getUTCFullYear() !== year ||
    parsed.getUTCMonth() + 1 !== month ||
    parsed.getUTCDate() !== day
  ) {
    throw new Error('Visit date is not a valid calendar date.');
  }

  const compactDate = `${dateMatch[3]}${dateMatch[2]}${dateMatch[1]}`;
  const monthKey = `${dateMatch[2]}${dateMatch[1]}`;
  let highestSerial = 0;

  (Array.isArray(existingCodes) ? existingCodes : []).forEach(code => {
    const codeMatch = /^(TLD|TDD)-(\d{2})(\d{2})(\d{4})-(\d+)$/.exec(String(code || '').trim());
    if (!codeMatch || `${codeMatch[3]}${codeMatch[4]}` !== monthKey) return;
    highestSerial = Math.max(highestSerial, Number(codeMatch[5]));
  });

  return `${prefix}-${compactDate}-${String(highestSerial + 1).padStart(3, '0')}`;
}

function generateVisitCode_(sheet, prefix, dateValue) {
  const lastRow = sheet.getLastRow();
  const existingCodes = lastRow > 1
    ? sheet.getRange(2, 2, lastRow - 1, 1).getDisplayValues().map(row => row[0])
    : [];
  return buildVisitCode_(prefix, dateValue, existingCodes);
}

function includeOrganizationStructure_() {
  return HtmlService.createHtmlOutputFromFile('OrganizationStructure').getContent();
}

function registerTamuLuar(payload) {
  validateTldRequiredFields_(payload);
  const destination = prepareTldVisit_(payload);

  const lock = LockService.getScriptLock();
  lock.waitLock(30000);
  try {
    const ss = getSharedSpreadsheet_();
    const sheetTamu = ss.getSheetByName('Data_Tamu');
    if (!sheetTamu) throw new Error('Sheet Data_Tamu tidak ditemukan pada database bersama.');

    const nextId = sheetTamu.getLastRow();
    const dateValue = payload.tanggal_kunjungan || Utilities.formatDate(new Date(), 'Asia/Jakarta', 'yyyy-MM-dd');
    const kodeKunjungan = generateVisitCode_(sheetTamu, 'TLD', dateValue);
    const timeNow = Utilities.formatDate(new Date(), 'Asia/Jakarta', 'yyyy-MM-dd HH:mm:ss');
    // Every TLD registration follows the admin approval/SPPD workflow.
    const isBawaSppd = 1;

    const urlSuratKunjungan = payload.surat_kunjungan_base64
      ? saveBase64ToDrive_(payload.surat_kunjungan_base64, `Surat_Kunjungan_${kodeKunjungan}`, 'application/pdf')
      : '';
    const urlSuratTugas = payload.surat_tugas_base64
      ? saveBase64ToDrive_(payload.surat_tugas_base64, `Surat_Tugas_${kodeKunjungan}`, 'application/pdf')
      : '';

    sheetTamu.appendRow([
      nextId, kodeKunjungan, 'luar_daerah', payload.instansi, payload.alamat || '',
      Number(payload.jumlah_orang) || 1, payload.ketua_nama, payload.pengikut_list || '',
      destination.bidang, payload.keperluan, payload.narahubung_nama || payload.ketua_nama,
      payload.narahubung_hp, dateValue, payload.jam_kunjungan || '09:00',
      urlSuratKunjungan, urlSuratTugas, destination.picIds, destination.pic, isBawaSppd, 'Menunggu Konfirmasi', timeNow
    ]);

    if (isBawaSppd) {
      const sheetSppd = ss.getSheetByName('Kendali_SPPD');
      if (sheetSppd) {
        const sppdId = sheetSppd.getLastRow();
        sheetSppd.appendRow([
          sppdId, nextId, kodeKunjungan, payload.instansi, payload.ketua_nama,
          '', '', '', 'Belum Lengkap', 'Belum TTD', '-', '-', 'Belum TTD', '-', '-',
          'Pendaftaran tamu luar daerah. Menunggu pelaksanaan dan kelengkapan bukti.', timeNow
        ]);
        sortSppd_(ss);
      }
    }

    sortTamu_(ss);
    return {
      success: true,
      message: 'Pendaftaran kunjungan berhasil.',
      data: {
        kode_kunjungan: kodeKunjungan,
        lo_nama: destination.pic,
        lo_jabatan: 'PIC Bidang Tujuan',
        tujuan_bidang: destination.bidang
      }
    };
  } finally {
    lock.releaseLock();
  }
}

function registerTamuFo(payload) {
  const destination = prepareTddVisit_(payload);

  const lock = LockService.getScriptLock();
  lock.waitLock(30000);
  try {
    const ss = getSharedSpreadsheet_();
    const sheetTamu = ss.getSheetByName('Data_Tamu');
    if (!sheetTamu) throw new Error('Sheet Data_Tamu tidak ditemukan pada database bersama.');

    const nextId = sheetTamu.getLastRow();
    const submittedAt = new Date();
    const today = Utilities.formatDate(submittedAt, 'Asia/Jakarta', 'yyyy-MM-dd');
    const nowHours = Utilities.formatDate(submittedAt, 'Asia/Jakarta', 'HH:mm');
    const kodeKunjungan = generateVisitCode_(sheetTamu, 'TDD', today);
    const timeNow = Utilities.formatDate(submittedAt, 'Asia/Jakarta', 'yyyy-MM-dd HH:mm:ss');

    sheetTamu.appendRow([
      nextId, kodeKunjungan, 'dalam_daerah_fo', payload.instansi || 'Perorangan', payload.alamat || '',
      Number(payload.jumlah_orang), payload.ketua_nama, payload.pengikut_list || '',
      destination.bidang, payload.keperluan, payload.ketua_nama, payload.narahubung_hp,
      today, nowHours, '', '', destination.picIds, destination.pic, 0, 'Diterima', timeNow
    ]);

    sortTamu_(ss);
    return {
      success: true,
      message: 'Pendaftaran kunjungan berhasil.',
      data: { kode_kunjungan: kodeKunjungan, lo_nama: destination.pic, tujuan_bidang: destination.bidang }
    };
  } finally {
    lock.releaseLock();
  }
}
return {registerTamuLuar:registerTamuLuar,registerTamuFo:registerTamuFo,database:getSharedSpreadsheet_,buildVisitCode:buildVisitCode_,directory:function(kind){if(kind==='tdd')return getTddPublicDestinations_();if(kind==='tld')return getTldPublicDestinations_();throw new Error('Form tidak ditemukan.');}};
})();
function publicRegisterTamuLuar(payload){return SI_TARI_INTAKE_.registerTamuLuar(payload);}
function publicRegisterTamuFo(payload){return SI_TARI_INTAKE_.registerTamuFo(payload);}
function getPublicFormDestinations(kind){return SI_TARI_INTAKE_.directory(kind);}
